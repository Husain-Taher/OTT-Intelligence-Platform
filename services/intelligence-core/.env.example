# --- Auth0 (API) ---------------------------------------------------------
# Auth0 Dashboard > Applications > APIs > Create API. Identifier = AUTH0_AUDIENCE.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://ott-intelligence-api

# Local UI work without Auth0 (every request becomes "default_user"). Never in production.
AUTH_DISABLED=false
APP_ENV=development

# Comma separated browser origins allowed to call this API directly
CORS_ORIGINS=http://localhost:3000

# --- Content ingestion -----------------------------------------------------
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=
