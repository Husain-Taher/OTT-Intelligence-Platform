# --- Auth0 (Regular Web Application) ---------------------------------------
# Generate with: openssl rand -hex 32
AUTH0_SECRET=
AUTH0_BASE_URL=http://localhost:3000
AUTH0_ISSUER_BASE_URL=https://YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# The API identifier from Auth0 > Applications > APIs (must match AUTH0_AUDIENCE in the FastAPI .env)
AUTH0_AUDIENCE=https://ott-intelligence-api

# --- Recommendation service ---------------------------------------------------
OTT_API_URL=http://127.0.0.1:8000

# --- Local UI work without Auth0 (also set AUTH_DISABLED=true for FastAPI). Never in production. ---
# AUTH_DISABLED=true
# NEXT_PUBLIC_AUTH_DISABLED=true
